<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neutral_background"
    android:padding="24dp">

    <!-- Título da Seção -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Gerenciar Categorias"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/neutral_dark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo para Adicionar/Editar Categoria -->
    <EditText
        android:id="@+id/etNomeCategoria"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Nome da categoria"
        android:inputType="textCapWords"
        android:background="@android:drawable/editbox_background"
        android:paddingHorizontal="12dp"
        android:textColor="@color/neutral_dark"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnAdicionarCategoria"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"/>

    <Button
        android:id="@+id/btnAdicionarCategoria"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:text="Adicionar"
        app:layout_constraintTop_toTopOf="@id/etNomeCategoria"
        app:layout_constraintBottom_toBottomOf="@id/etNomeCategoria"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Lista de Categorias -->
    <ListView
        android:id="@+id/lvCategorias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        app:layout_constraintTop_toBottomOf="@id/etNomeCategoria"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>